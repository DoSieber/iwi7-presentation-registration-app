# Base URL of the Cloudflare Worker. This value ends up in the built JS bundle
# and is therefore public, which is fine. It is not a credential.
VITE_API_BASE=https://iwi7-registration-api.<your-subdomain>.workers.dev

# Optional. Cloudflare Turnstile site key (the public half of the key pair).
# Leave empty to run without bot protection.
VITE_TURNSTILE_SITE_KEY=
